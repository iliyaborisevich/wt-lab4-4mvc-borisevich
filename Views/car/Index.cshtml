@model List<wt_lab4_4mvc_borisevich.Models.Car>

@{
    ViewData["Title"] = "Автопарк";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Наш автопарк</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm">Добавить авто</a>
    </div>

    <div class="row">
        @foreach (var car in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow rounded h-100">
                    <div class="card-body">
                        <h5 class="card-title">@car.Brand @car.Model</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@car.Year г.</h6>
                        <p class="card-text fs-5 text-primary">@car.PricePerDay BYN / день</p>
                        
                        @if (car.IsAvailable)
                        {
                            <span class="badge bg-success">Доступен</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">В аренде</span>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between pb-3">
                        <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-outline-warning btn-sm">Изменить</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>